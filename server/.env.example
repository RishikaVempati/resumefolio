# ─── Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Google Gemini API Key — FREE at https://aistudio.google.com
GEMINI_API_KEY=

# Gemini model. The spec names gemini-1.5-flash, which now returns 404;
# gemini-3.5-flash-lite is verified working and much faster.
GEMINI_MODEL=gemini-3.5-flash-lite

# Server port
PORT=3001

# Deployed frontend origin, added to the CORS allow-list in production.
CLIENT_ORIGIN=
