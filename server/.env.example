# Copy to .env inside server/ and fill in real values. Never commit .env.

# Google AI Studio key. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Verified working 2026-08-28. The spec names gemini-1.5-flash, which now 404s.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3001

# Deployed frontend origin, added to the CORS allow-list in production.
CLIENT_ORIGIN=
